<?xml version="1.0" encoding="UTF-8"?>
<settings xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.1.0 http://maven.apache.org/xsd/settings-1.1.0.xsd" xmlns="http://maven.apache.org/SETTINGS/1.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <proxies>
    <proxy>
      <id>internal-http</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>proxy.bloomberg.com</host>
      <port>81</port>
      <nonProxyHosts>localhost|*.bloomberg.com|bloomberg.com</nonProxyHosts>
    </proxy>
    <proxy>
      <id>internal-https</id>
      <active>true</active>
      <protocol>http</protocol>
      <host>proxy.bloomberg.com</host>
      <port>81</port>
      <nonProxyHosts>localhost|*.bloomberg.com|bloomberg.com</nonProxyHosts>
    </proxy>
  </proxies>
  <mirrors>
     <mirror>
        <mirrorOf>*,!osgeo,!libs-snapshot-unique</mirrorOf>
        <name>repo</name>
        <url>https://artprod.dev.bloomberg.com/artifactory/root-repos</url>
        <id>repo</id>
     </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>artifactory</id>
      <repositories>
        <repository>
          <snapshots>
            <enabled>false</enabled>
            <checksumPolicy>warn</checksumPolicy>
          </snapshots>
          <id>central</id>
          <name>libs-release</name>
          <url>https://artprod.dev.bloomberg.com/artifactory/libs-release</url>
        </repository>
        <repository>
          <snapshots>
            <checksumPolicy>warn</checksumPolicy>
          </snapshots>
          <id>snapshots</id>
          <name>libs-snapshot</name>
          <url>https://artprod.dev.bloomberg.com/artifactory/libs-snapshot</url>
        </repository>
        <repository>
          <snapshots>
              <enabled>true</enabled>
              <checksumPolicy>warn</checksumPolicy>
          </snapshots>
          <id>libs-snapshot-unique</id>
          <name>libs-snapshot-unique</name>
          <url>https://artprod.dev.bloomberg.com/artifactory/libs-snapshot-unique</url>
        </repository>
        <repository>
          <snapshots>
            <checksumPolicy>warn</checksumPolicy>
          </snapshots>
          <id>snapshots</id>
          <name>java-local-remotes</name>
          <url>https://artprod.dev.bloomberg.com/artifactory/java-local-remotes</url>
        </repository>
        <repository>
          <id>confluent</id>
          <name>confluent_io_maven</name>
          <url>https://artprod.dev.bloomberg.com/artifactory/remote-repos</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <snapshots>
            <enabled>false</enabled>
            <checksumPolicy>warn</checksumPolicy>
          </snapshots>
          <id>central</id>
          <name>plugins-release</name>
          <url>https://artprod.dev.bloomberg.com/artifactory/plugins-release</url>
        </pluginRepository>
        <pluginRepository>
          <snapshots>
            <checksumPolicy>warn</checksumPolicy>
          </snapshots>
          <id>snapshots</id>
          <name>plugins-release</name>
          <url>https://artprod.dev.bloomberg.com/artifactory/plugins-release</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>artifactory</activeProfile>
  </activeProfiles>
</settings>
